import pandas as pd

df = pd.read_csv('winequality-red.csv')


df.head()


# summary of a DataFrame
df.info()


# gives descriptive statistics of the dataset
df.describe()


df.shape


# list down all the columns
df.columns


# gives unique values in the particular column
df['quality'].unique()


# missing values in the dataset
df.isnull().sum()


df.duplicated()


df[df.duplicated()]


# Removing duplicates
df.drop_duplicates(inplace = True)


df.shape # duplicate rows 240 removed


df.corr()


import seaborn as sns
import matplotlib.pyplot as plt
plt.figure(figsize = (10, 6))
sns.heatmap(df.corr(), annot = True)



df.quality.value_counts()


# conclusion - imbalanced dataset 

df.quality.value_counts().plot(kind = 'bar')
plt.xlabel('wine quality')
plt.ylabel('count')


for column in df.columns:
    sns.histplot(df[column], kde = True)


sns.histplot(df['alcohol'], kde = True)


# univariate, bivariate, multivariate
sns.pairplot(df)


# categorical plot
sns.catplot(x = 'quality', y='alcohol', data = df, kind = 'box')


sns.scatterplot(x = 'alcohol', y = 'pH', hue = 'quality')



